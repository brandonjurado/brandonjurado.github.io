{
  "homepage": "https://bjurado.com/",
  "name": "brandonjurado.github.io",
  "author": "Brandon Jurado",
  "version": "1.0.0",
  "private": true,
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.4",
    "node": "^26.12.1"
  },
  "dependencies": {
    "lottie-web": "5.13.0",
    "motion": "14.6.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "scripts": {
    "dev": "bun run prepare:assets && vite",
    "start": "bun run dev",
    "build": "bun run prepare:assets && vite build && vite build --ssr src/entry-server.tsx --outDir .prerender && node scripts/prerender.mjs",
    "preview": "node scripts/preview-server.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,scss,css}\" \"scripts/*.mjs\" \"tests/*.mjs\" \"*.{mjs,cjs,json}\" \"index.html\" \"public/manifest.json\" \".github/workflows/*.yml\"",
    "check-format": "prettier --check \"src/**/*.{ts,tsx,scss,css}\" \"scripts/*.mjs\" \"tests/*.mjs\" \"*.{mjs,cjs,json}\" \"index.html\" \"public/manifest.json\" \".github/workflows/*.yml\"",
    "test": "bun run test:static && bun run test:browser",
    "typecheck": "tsrs --noEmit",
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "lint": "eslint .",
    "check:bundle": "node scripts/check-bundle.mjs",
    "test:static": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "lhci": "lhci autorun",
    "prepare:data": "bun run scripts/fetch-profile.mjs",
    "typecheck:typescript": "tsc --noEmit"
  },
  "browserslist": {
    "production": [
      ">0.3%",
      "not ie 11",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      ">0.3%",
      "not ie 11",
      "not dead",
      "not op_mini all",
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@lhci/cli": "0.15.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "6.1.2",
    "dotenv": "18.0.9",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "lightningcss": "1.33.0",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "rolldown": "1.2.15",
    "sass": "1.106.1",
    "sharp": "0.35.5",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5"
  },
  "type": "module",
  "overrides": {
    "lighthouse": "13.5.0",
    "basic-ftp": "6.2.3",
    "tmp": "0.2.7",
    "uuid": "14.0.3"
  }
}
