{
  "homepage": "https://bjurado.com/",
  "name": "brandonjurado.github.io",
  "author": "Brandon Jurado",
  "version": "1.0.0",
  "private": true,
  "packageManager": "bun@1.3.6",
  "engines": {
    "bun": ">=1.3.6",
    "node": ">=22.12.0 || ^20.19.0"
  },
  "dependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "lottie-web": "5.13.0"
  },
  "scripts": {
    "prepare:data": "bun run scripts/fetch-profile.mjs",
    "dev": "bun run prepare:assets && vite",
    "start": "bun run dev",
    "build": "bun run prepare:assets && vite build && vite build --ssr src/entry-server.tsx --outDir .prerender && node scripts/prerender.mjs",
    "preview": "vite preview",
    "format": "prettier --write \"./**/*.{js,jsx,ts,tsx,css,json,scss}\"",
    "check-format": "prettier -c \"./**/*.{js,jsx,ts,tsx,css,json,scss}\"",
    "test": "vitest run --config vitest.config.mjs --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "prepare:assets": "node scripts/prepare-assets.mjs"
  },
  "browserslist": {
    "production": [
      ">0.3%",
      "not ie 11",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      ">0.3%",
      "not ie 11",
      "not dead",
      "not op_mini all",
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "5.2.0",
    "jsdom": "^28.1.0",
    "lightningcss": "^1.31.1",
    "prettier": "^3.8.1",
    "vite": "^7.3.1",
    "vitest": "^4.0.18",
    "sass": "^1.97.3",
    "typescript": "~5.9.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "sharp": "^0.34.5",
    "dotenv": "^17.3.1"
  }
}
