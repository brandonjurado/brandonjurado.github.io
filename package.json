{
  "homepage": "https://bjurado.com/",
  "name": "brandonjurado.github.io",
  "author": "Brandon Jurado",
  "version": "1.0.0",
  "private": true,
  "packageManager": "bun@1.3.6",
  "engines": {
    "bun": ">=1.3.6",
    "node": ">=22.12.0 || ^20.19.0"
  },
  "dependencies": {
    "lottie-web": "5.13.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "scripts": {
    "dev": "bun run prepare:assets && vite",
    "start": "bun run dev",
    "build": "bun run prepare:assets && vite build && vite build --ssr src/entry-server.tsx --outDir .prerender && node scripts/prerender.mjs",
    "preview": "node scripts/preview-server.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,scss,css}\" \"scripts/*.mjs\" \"tests/*.mjs\" \"*.{mjs,cjs,json}\" \"index.html\" \"public/manifest.json\" \".github/workflows/*.yml\"",
    "check-format": "prettier --check \"src/**/*.{ts,tsx,scss,css}\" \"scripts/*.mjs\" \"tests/*.mjs\" \"*.{mjs,cjs,json}\" \"index.html\" \"public/manifest.json\" \".github/workflows/*.yml\"",
    "test": "bun run test:static && bun run test:browser",
    "typecheck": "tsc --noEmit",
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "lint": "eslint .",
    "check:bundle": "node scripts/check-bundle.mjs",
    "test:static": "node --test tests/static.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "lhci": "lhci autorun",
    "prepare:data": "bun run scripts/fetch-profile.mjs"
  },
  "browserslist": {
    "production": [
      ">0.3%",
      "not ie 11",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      ">0.3%",
      "not ie 11",
      "not dead",
      "not op_mini all",
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "@eslint/js": "9.39.1",
    "@lhci/cli": "0.15.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "9.39.1",
    "globals": "16.5.0",
    "jsdom": "^28.1.0",
    "lightningcss": "^1.31.1",
    "playwright": "1.56.1",
    "prettier": "^3.8.1",
    "sass": "^1.97.3",
    "sharp": "^0.34.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.48.0",
    "vite": "^7.3.1",
    "dotenv": "^17.3.1"
  }
}
